# Base MongoDB (Atlas en ligne ; en local : docker compose up -d)
MONGODB_URI=mongodb://localhost:27017/devoirs?directConnection=true

# Auth — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique du site (Vercel : https://<projet>.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# App mobile
MOBILE_APP_SCHEME=devoirsia://
# Origines supplémentaires autorisées, séparées par des virgules (Expo web en dev)
TRUSTED_ORIGINS=http://localhost:8081

# Connexion Google / Apple — optionnel : laissez vide pour désactiver
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Administration : e-mails des comptes admin, séparés par des virgules
ADMIN_EMAILS=

# IA (API Claude) — sans clé, la génération d'exercices est désactivée
ANTHROPIC_API_KEY=
# Budget IA quotidien en dollars (5 par défaut) : au-delà, la génération est suspendue jusqu'au lendemain
AI_DAILY_BUDGET_USD=5
# Modèles (facultatif) : par défaut claude-opus-5-5 et claude-haiku-5-5
AI_MODEL_STRONG=
AI_MODEL_FAST=
