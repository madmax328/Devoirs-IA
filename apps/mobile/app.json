{
  "expo": {
    "name": "Devoirs IA",
    "slug": "devoirs-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.devoirsia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.devoirsia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "devoirsia",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'acc\u00e9der \u00e0 tes photos pour que tu puisses envoyer ton exercice \u00e0 ton coach.",
          "cameraPermission": "L'application a besoin de l'appareil photo pour que tu puisses photographier ton exercice.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
